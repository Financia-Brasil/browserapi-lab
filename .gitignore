# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Perfis de navegador (nunca versionar: contêm sessão/login)
profiles/*
!profiles/.gitkeep

# Resultados de execução (podem conter diagnóstico de sessões reais)
results/*
!results/.gitkeep
!results/samples/
!results/samples/**
# evidencias de CI (sanitizadas) sao versionadas de proposito
!results/ci/
!results/ci/**

# Navegadores baixados gerenciados
.ms-playwright/

# Artefatos de diagnóstico
*.png
*.zip
traces/
screenshots/

# Sistema
.DS_Store
*.swp

# Configurações e recibos locais (URLs/seletores podem ser privados)
.browserapi/
.chat-config/

# Instaladores gerados (entregues fora do Git)
*.deb

# Instalador publicado a pedido do usuário
!downloads/BrowserAPI-Ubuntu.deb

# Runtime publicado para atualização automática ABI 1
!downloads/BrowserAPI-runtime.zip

# Chaves locais, fingerprints privados e conteúdo RAG (nunca commitar)
api-policy.json
api-idempotency.json
context.sqlite3*
